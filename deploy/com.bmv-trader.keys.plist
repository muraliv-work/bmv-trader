<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Key tracker (DECISION S43): daily at 09:00 Mac time, a notification if any key is 10 days or less from due, overdue, missing, or its automatic rotation failed. Names and dates only, never a key. Install: deploy/README.md -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.bmv-trader.keys</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/balamuralivallappa/Documents/projects/bmv/bmv-trader/target/release/bmv-trader</string>
    <string>keys</string>
    <string>--notify</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>BMV_HOME</key>
    <string>/Users/balamuralivallappa/Documents/projects/bmv/bmv-trader</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/balamuralivallappa/Documents/projects/bmv/bmv-trader/data/keys.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/balamuralivallappa/Documents/projects/bmv/bmv-trader/data/keys.log</string>
</dict>
</plist>
