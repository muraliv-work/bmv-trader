# Copy to .env and fill in. .env is gitignored; this file is committed with no values.
# .env is read from $BMV_HOME (default: this checkout). Set BMV_HOME in the launchd plist when deploying.
# Config is read from this file only. The program refuses to start if TRADING_MODE, LIVE_CONFIRM
# or any ALPACA_* variable is also set in your shell, and if .env is readable by others (chmod 600 .env).

# paper (default) | live
TRADING_MODE=paper
# Required only for live, must be exactly: yes-i-accept-real-losses
LIVE_CONFIRM=

# Alpaca keys are read from the macOS Keychain first (service "bmv-trader", account = the
# variable name). Store one with (it prompts for the value, so it stays out of shell history):
#   security add-generic-password -s bmv-trader -a ALPACA_PAPER_SECRET -w
# A key in both the Keychain and this file is refused.

# Alpaca paper keys: app.alpaca.markets → Paper account → API Keys. Allowed here or in the Keychain.
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET=
# Alpaca live keys: KEYCHAIN ONLY. Live mode refuses to start if they appear in this file:
#   security add-generic-password -s bmv-trader -a ALPACA_LIVE_KEY_ID -w
#   security add-generic-password -s bmv-trader -a ALPACA_LIVE_SECRET -w

# OmniRoute (local free-model gateway): dashboard → Endpoints
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=

# Claude (console.anthropic.com)
ANTHROPIC_API_KEY=
